<Window x:Class="SDUDPMEUHMEPTQILSPX.SelectTracksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDUDPMEUHMEPTQILSPX"
        Title="Select Tracks" Height="400" Width="600"
        WindowStartupLocation="CenterOwner"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="OK" Width="80" Margin="5" Click="BtnOk_Click"/>
            <Button Content="Cancel" Width="80" Margin="5" Click="BtnCancel_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgTracks" PreviewMouseLeftButtonDown="dgTracks_PreviewMouseLeftButtonDown"
              AutoGenerateColumns="False"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              IsReadOnly="True"
              SelectionMode="Extended"
              SelectionUnit="FullRow"
              DockPanel.Dock="Top">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="3*"/>
                <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="2*"/>
                <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="2*"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding DurationString}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>