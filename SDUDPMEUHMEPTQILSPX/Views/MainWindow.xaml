<Window x:Class="SDUDPMEUHMEPTQILSPX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDUDPMEUHMEPTQILSPX"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Super Duper Ultra Deluxe Pro Max Elite Ultimate Hyper Mega Extreme Platinum Turbo Quantum Infinity Legendary Supreme Prime X 😎🔥 Music Player™ ® ©" 
        Height="500" 
        Width="1250"
        MinWidth="1550"
        MinHeight="300"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:conv="clr-namespace:SDUDPMEUHMEPTQILSPX.Converters">
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>

    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="200" MaxWidth="500"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="800"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition MinWidth="200" MaxWidth="500"/>
        </Grid.ColumnDefinitions>

        <vlc:VideoView x:Name="videoView" Visibility="Collapsed" />
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Library" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
            <Button Grid.Row="1" x:Name="btnHome" Content="🏠 Home" Margin="0 0 0 10" Click="OpenHome"/>

            <Expander Grid.Row="2" Header="Playlists" IsExpanded="True" Margin="0 0 0 10">
                <ListBox x:Name="lbPlaylists" ItemsSource="{Binding AllPlaylists}" MouseDoubleClick="OpenPlaylist">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Delete" Click="DeletePlaylist"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Expander>

            <Border Grid.Row="3" Margin="0,10,0,0" Padding="8" CornerRadius="6" Visibility="{Binding CurrentTrack, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <Image Width="50" Height="50" Margin="0 0 10 0"
                           Source="{Binding CurrentTrack.CoverImage}"
                           Visibility="{Binding CurrentTrack.CoverImage}"
                           Stretch="UniformToFill" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentTrack.Title}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding CurrentTrack.Artist}" FontStyle="Italic"/>
                        <TextBlock Text="{Binding CurrentTrack.Album}" />
                        <TextBlock Text="{Binding CurrentTrack.DurationString}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>


        <GridSplitter Grid.Column="1"
              Width="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="Gray"
              ResizeBehavior="PreviousAndNext"
              ResizeDirection="Columns"/>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="lblViewHeader"
                           Text="🏠 Home"
                           FontWeight="Bold"
                           FontSize="16"
                           VerticalAlignment="Center"
                           Grid.Column="0" />
                
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
                    <Button x:Name="btnAddTrack" Content="Add new tracks" Margin="5" Click="AddTrackToLibrary"/>
                    <Button x:Name="btnAddTracksPlaylist" Content="Add tracks to the playlist" Padding="10,5" Margin="5" Click="AddTracksToPlaylist" Visibility="Collapsed"/>
                    <Button x:Name="btnCreatePlaylist" Content="Create Playlist" Padding="10,5" Margin="5" Click="CreatePlaylist"/>
                    <Button x:Name="btnDownload" Content="Download from YT" Padding="10,5" Margin="5" Click="DownloadYoutube"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="10">
                <DataGrid x:Name="dgLibrary"
                          ItemsSource="{Binding DisplayedTracks}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          MouseDoubleClick="dgLibrary_MouseDoubleClick"
                          ContextMenuOpening="dgLibrary_ContextMenuOpening"
                          Margin="10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="3*" />
                        <DataGridTextColumn Header="Album" Binding="{Binding Album}" Width="2*" />
                        <DataGridTextColumn Header="Artist" Binding="{Binding Artist}" Width="2*" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationString}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Grid.Row="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnPrev" Grid.Row="0" Grid.Column="0" Content="Previous" Margin="5" Click="btnPrev_Click" IsEnabled="False"/>
                <Button x:Name="btnPlay" Grid.Row="0" Grid.Column="1" Content="Play" Margin="5" Click="btnPlay_Click" IsEnabled="False"/>
                <Button x:Name="btnNext" Grid.Row="0" Grid.Column="2" Content="Next" Margin="5" Click="btnNext_Click" IsEnabled="False"/>
                <Button x:Name="btnRepeat" Grid.Row="0" Grid.Column="3" Content="🔁" Margin="5" Click="btnRepeat_Click" Opacity="0.5"/>

                <Slider x:Name="sliderPosition" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Margin="5" Maximum="1"
                        IsMoveToPointEnabled="True" PreviewMouseDown="sliderPosition_PreviewMouseDown"
                        PreviewMouseUp="sliderPosition_PreviewMouseUp" HorizontalAlignment="Stretch"/>

                <Label x:Name="lblPosition" Grid.Row="2" Grid.Column="8" Content="00:00/00:00" Margin="5" VerticalAlignment="Center"/>

                <Slider x:Name="sliderVolume" Grid.Row="2" Grid.Column="10" Maximum="100" SmallChange="1"
                        Value="50" IsMoveToPointEnabled="True" Margin="5" ValueChanged="sliderVolume_ValueChanged"/>
                <xctk:IntegerUpDown x:Name="intVolume" Grid.Row="2" Grid.Column="11" Increment="1" Minimum="0" Maximum="100"
                                    Text="50" Margin="15,5,5,5" ValueChanged="intVolume_ValueChanged"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="3"
              Width="5"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="Gray"
              ResizeBehavior="PreviousAndNext"
              ResizeDirection="Columns"/>


        <Grid Grid.Column="4" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Queue" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>

            <ListBox x:Name="lbQueue"
             Grid.Row="1"
             ItemsSource="{Binding Queue}"
             SelectedItem="{Binding CurrentTrack, Mode=TwoWay}"
             PreviewMouseRightButtonDown="lbQueue_PreviewMouseRightButtonDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove" Click="miQueueRemove_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

    </Grid>
</Window>
