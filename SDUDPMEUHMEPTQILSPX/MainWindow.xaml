<Window x:Class="SDUDPMEUHMEPTQILSPX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SDUDPMEUHMEPTQILSPX"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Super Duper Ultra Deluxe Pro Max Elite Ultimate Hyper Mega Extreme Platinum Turbo Quantum Infinity Legendary Supreme Prime X 😎🔥 Music Player™ ® ©" 
        Height="500" 
        Width="1250"
        MinWidth="1250"
        MinHeight="300"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <MediaElement x:Name="mediaElement" LoadedBehavior="Manual" UnloadedBehavior="Stop" Visibility="Collapsed"/>

        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="Library" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
            <ListBox x:Name="lbPlaylists" DisplayMemberPath="Name" />
        </StackPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button x:Name="btnAddTrack" Content="+" Width="40" Height="40" Margin="5" Click="btnAddTrack_Click"/>
                <Button Content="Create Playlist" Padding="10,5" Margin="5"/>
            </StackPanel>

            <Grid Grid.Row="1" Background="WhiteSmoke" Margin="10">
            </Grid>

            <Grid Grid.Row="2" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnPrev" Grid.Row="0" Grid.Column="0" Content="Previous" Margin="5" Click="btnPrev_Click" IsEnabled="False"/>
                <Button x:Name="btnPlay" Grid.Row="0" Grid.Column="3" Content="Play" Margin="5" Click="btnPlay_Click" IsEnabled="False"/>
                <Button x:Name="btnNext" Grid.Row="0" Grid.Column="5" Content="Next" Margin="5" Click="btnNext_Click" IsEnabled="False"/>

                <Label x:Name="lblCurrentTrack" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="12" Content="{Binding CurrentTrack.Title}" Margin="5"/>

                <Slider x:Name="sliderPosition" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="8" Margin="5" Maximum="1"
                        IsMoveToPointEnabled="True" PreviewMouseDown="sliderPosition_PreviewMouseDown"
                        PreviewMouseUp="sliderPosition_PreviewMouseUp" HorizontalAlignment="Stretch"/>

                <Label x:Name="lblPosition" Grid.Row="2" Grid.Column="8" Content="00:00/00:00" Margin="5" VerticalAlignment="Center"/>

                <Slider x:Name="sliderVolume" Grid.Row="2" Grid.Column="10" Maximum="1" SmallChange="0.01"
                        Value="0.5" IsMoveToPointEnabled="True" Margin="5" ValueChanged="sliderVolume_ValueChanged"/>
                <xctk:IntegerUpDown x:Name="intVolume" Grid.Row="2" Grid.Column="11" Increment="1" Minimum="0" Maximum="100"
                                    Text="50" Width="72" Margin="5" ValueChanged="intVolume_ValueChanged"/>
            </Grid>
        </Grid>

        <StackPanel Grid.Column="2" Margin="10">
            <TextBlock Text="Queue" FontWeight="Bold" FontSize="14" Margin="0 0 0 10"/>
            <ListBox x:Name="lbQueue"
                     ItemsSource="{Binding Queue}"
                     SelectedItem="{Binding CurrentTrack, Mode=TwoWay}"
                     PreviewMouseRightButtonDown="lbQueue_PreviewMouseRightButtonDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Name="miRemove"  Header="Remove" Click="miRemove_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</Window>
